FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache bash

# Копируем package.json и package-lock.json если они есть
COPY frontend/package.json frontend/package-lock.json* ./

# Устанавливаем зависимости если есть package.json
RUN if [ -f package.json ]; then npm ci --only=production || npm install; fi

# Код монтируется томом в dev-режиме

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]









